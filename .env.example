# Ollama — required for plant identification and care calendar (no hardcoded plant DB).
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="gemma4:31b-cloud"

# Local JSON persistence (settings, plants, tasks, cached Ollama plant profiles).
# YARD_SLOTH_DATA_FILE="/absolute/path/to/yard_sloth.json"

# Optional legacy AI Studio variables (not used by the Python agents).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
